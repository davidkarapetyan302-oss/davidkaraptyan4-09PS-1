<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_gravity="center_vertical">

            <!-- Логотип и название -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_background"
                    android:gravity="center"
                    android:text="⏰"
                    android:textSize="40sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Электронный табель"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Учет рабочего времени"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.9"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Карточка входа -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/modern_card"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Вход в систему"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="24dp"/>

                <!-- Поле логина -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Логин"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Введите логин"
                    android:textSize="16sp"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Поле пароля -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пароль"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Введите пароль"
                    android:textSize="16sp"
                    android:inputType="textPassword"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="24dp"/>

                <!-- Кнопка входа -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ВОЙТИ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/modern_button"
                    android:layout_marginBottom="16dp"/>

                <!-- Ссылка на регистрацию -->
                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нет аккаунта? Зарегистрироваться"
                    android:textSize="14sp"
                    android:textColor="#6366F1"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>

            <!-- Информация -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="НИИ Центрпрограммсистем"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:alpha="0.7"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>