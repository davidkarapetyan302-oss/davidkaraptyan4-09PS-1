<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/modern_card"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мой профиль"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp"/>

            <!-- Аватар -->
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/gradient_background"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ИИ"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- ФИО -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ФИО"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfileFio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Иванов Иван Иванович"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp"/>

            <!-- Должность -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Должность"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfilePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Инженер-программист"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp"/>

            <!-- Отдел -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отдел"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfileDepartment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отдел разработки"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp"/>

            <!-- Логин -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Логин"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfileLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ivanov"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp"/>

            <!-- Телефон -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Телефон"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+7 (111) 222-33-44"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ivanov@mail.ru"
                android:textSize="18sp"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="НАЗАД"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/modern_button"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</ScrollView>